over "Flattened_Prototype_32"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_32.inputs:diffuseColor>
        float inputs:ior.connect = </Flattened_Prototype_32.inputs:ior>
        float inputs:metallic.connect = </Flattened_Prototype_32.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_32.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_32.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

